rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ──────────────────────────────────────────────
    // Self-service profile only: every account can read/create/update its
    // own document, and no one else's. The role can be chosen once, at
    // creation, and never changed afterwards. Nothing in this document is
    // used to authorize access to other data (hospital access is decided
    // by hospitals/{id}.owner_uids, which clients cannot grant). No
    // deletes from the client.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role in ['DRIVER', 'HOSPITAL_STAFF'];
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ── hospitals/{hospitalId} ───────────────────────────────────
    // Any authenticated user can read every hospital — ambulance drivers
    // need to read the full directory to score/route against all of them.
    // Self-service creation: any authenticated user may create a new
    // hospital, but only if they name themselves as the sole initial
    // owner, it starts un-archived, and its numbers are sane (bounded
    // counts, valid coordinates) so a malformed record can't distort
    // routing. Once created, only staff listed in owner_uids may update
    // it, and only the fields the app's edit/resource/archive flows write
    // — owner_uids itself is deliberately excluded, so reassigning
    // ownership is an admin-only operation done outside the app. Hard
    // delete is denied entirely; "removing" a hospital is a soft archive.
    match /hospitals/{hospitalId} {
      function validHospital(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && (!('contact' in d) || (d.contact is string && d.contact.size() <= 40))
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.vacant_icu_beds is int
          && d.vacant_icu_beds >= 0 && d.vacant_icu_beds <= 999
          && d.available_ventilators is int
          && d.available_ventilators >= 0 && d.available_ventilators <= 999
          && (!('archived' in d) || d.archived is bool);
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.owner_uids == [request.auth.uid]
        && request.resource.data.archived == false
        && validHospital(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid in resource.data.owner_uids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'vacant_icu_beds', 'available_ventilators',
               'name', 'contact', 'lat', 'lng', 'archived'
             ])
        && validHospital(request.resource.data);

      allow delete: if false;
    }

    // ── bookings/{bookingId} ─────────────────────────────────────
    // Only a registered driver may create a booking, under their own uid,
    // and it must start EN_ROUTE. The owning driver may then update only
    // the live position and the status. Read access: the owning driver, or
    // an owner of the booking's target hospital (checked against the
    // hospital's owner_uids, which clients cannot modify).
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.driver_uid == request.auth.uid
        && request.resource.data.status == 'EN_ROUTE'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role == 'DRIVER';

      allow update: if request.auth != null
        && request.auth.uid == resource.data.driver_uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['current_lat', 'current_lng', 'status']);

      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver_uid
            || request.auth.uid in
                 get(/databases/$(database)/documents/hospitals/$(resource.data.target_hospital_id))
                   .data.owner_uids);

      allow delete: if false;
    }
  }
}
