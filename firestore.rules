rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ──────────────────────────────────────────────
    // Self-service profile only: every account can read/create/update its
    // own document, and no one else's. No deletes from the client.
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── hospitals/{hospitalId} ───────────────────────────────────
    // Any authenticated user can read every hospital — ambulance drivers
    // need to read the full directory to score/route against all of them.
    // Self-service creation: any authenticated user may create a new
    // hospital, but only if they name themselves as the sole initial
    // owner — this is what makes the in-app "Add Hospital" flow work
    // without an admin step, while still preventing anyone from creating
    // a hospital pre-assigned to someone else's uid. Once created, only
    // staff already listed in owner_uids may update it, and only the
    // fields the app's edit/resource/archive flows actually write —
    // owner_uids itself is deliberately excluded, so reassigning
    // ownership is still an admin-only operation done outside the app.
    // Hard delete is denied entirely; "removing" a hospital is a soft
    // archive (setting archived: true) so past booking references never
    // dangle.
    match /hospitals/{hospitalId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.owner_uids == [request.auth.uid];

      allow update: if request.auth != null
        && request.auth.uid in resource.data.owner_uids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'vacant_icu_beds', 'available_ventilators',
               'name', 'contact', 'lat', 'lng', 'archived'
             ]);

      allow delete: if false;
    }

    // ── bookings/{bookingId} ─────────────────────────────────────
    // A driver may only create/update bookings under their own uid.
    // Read access: the owning driver, or hospital staff whose own profile
    // lists the booking's target hospital in hospital_ids (kept as a
    // single-document check via the user's own profile rather than a
    // second document lookup on the hospital).
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.driver_uid == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.driver_uid;

      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver_uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.hospital_ids.hasAny([resource.data.target_hospital_id]));

      allow delete: if false;
    }
  }
}
